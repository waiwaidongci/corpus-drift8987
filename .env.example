COMPOSE_PROJECT_NAME=corpus-drift
FRONTEND_PORT=18215
BACKEND_PORT=19215
DB_PORT=17715
MYSQL_DATABASE=corpus
MYSQL_USER=corpus
MYSQL_PASSWORD=corpus_demo
MYSQL_ROOT_PASSWORD=root_corpus_demo
JWT_SECRET=local-demo-corpus-drift-change-for-deployment
SEED_DEMO=true
# 流式比较阈值（片段数）：超过则启用 SSCursor+外部归并的定界内存管线
STREAM_THRESHOLD=5000
# 比较中间外排文件目录（需可写，百万级约需数百MB磁盘）
SPOOL_DIR=/artifacts/spool
# 限制 glibc 内存 arena 数，压低百万行逐行处理后的 RSS 峰值
MALLOC_ARENA_MAX=2
